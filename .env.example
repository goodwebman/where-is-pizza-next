# Any PostgreSQL 14+ works — nothing in this project is provider-specific.
# Tested against postgres:17-alpine in Docker; the same URLs work for Supabase,
# Neon, Timeweb, Selectel or your own VPS.
#
# Local development:
#   docker run -d --name wip-postgres \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=whereispizza \
#     -p 5433:5432 postgres:17-alpine
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/whereispizza?schema=public"

# Used at runtime. On providers with a connection pooler (Supabase, Neon), this
# is the POOLED host — a serverless function must not hold a direct connection.
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# Used by `prisma migrate` and the seed. Must be the DIRECT (unpooled) host:
# PgBouncer in transaction mode cannot hold migration advisory locks.
# On a plain Postgres with no pooler, set this to the same value as above.
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# HS256 signing key for access tokens. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Optional. Mutating requests are checked against the origin the request itself
# arrived on, so previews and *.vercel.app work without configuration. Set this
# only when a custom domain fronts the deployment and should also be trusted.
SITE_URL="http://localhost:3000"

# Separate throwaway database for `npm run test:integration` — it gets wiped.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/postgres?schema=public"
