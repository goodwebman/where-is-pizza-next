{
  "name": "where-is-pizza-next-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:client\"",
    "dev:client": "yarn workspace client dev",
    "dev:server": "yarn workspace server dev",
    "build": "yarn workspace client build && yarn workspace server build",
    "start": "concurrently \"yarn workspace server start\" \"yarn workspace client start\"",
    "lint": "yarn workspace client lint",
    "prisma:generate": "yarn workspace server prisma:generate",
    "prisma:migrate": "yarn workspace server prisma:migrate"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "classnames": "^2.5.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "sass": "^1.97.3",
    "@prisma/client": "^5.0.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0"
  }
}
