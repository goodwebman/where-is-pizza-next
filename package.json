{
	"name": "where-is-pizza-next-monorepo",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"client",
		"server"
	],
	"scripts": {
		"dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
		"dev:client": "npm -w client run dev",
		"dev:server": "npm -w server run dev",
		"build": "npm -w client run build && npm -w server run build",
		"start": "concurrently \"npm -w server run start\" \"npm -w client run start\"",
		"lint": "npm -w client run lint",
		"test": "npm -w client run test",
		"prisma:generate": "npm -w server run prisma:generate",
		"prisma:migrate": "npm -w server run prisma:migrate"
	},
	"dependencies": {
		"@floating-ui/react": "^0.27.19",
		"@hookform/resolvers": "^5.2.2",
		"@prisma/adapter-better-sqlite3": "^7.4.1",
		"@prisma/client": "^7.4.1",
		"@reduxjs/toolkit": "^2.11.2",
		"@tanstack/react-query": "^5.90.21",
		"axios": "^1.13.5",
		"bcrypt": "^5.1.0",
		"classnames": "^2.5.1",
		"concurrently": "^8.2.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^17.3.1",
		"express": "^4.18.2",
		"framer-motion": "^12.35.0",
		"keen-slider": "^6.8.6",
		"next": "16.1.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-hook-form": "^7.71.1",
		"react-hot-toast": "^2.6.0",
		"react-redux": "^9.2.0",
		"redux-persist": "^6.0.0",
		"sass": "^1.97.3",
		"swiper": "^12.1.2",
		"uuid": "^13.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@svgr/cli": "^8.1.0",
		"@svgr/core": "^8.1.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.3.0",
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/cookie-parser": "^1.4.3",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.17",
		"@types/node": "^25.3.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.1.6",
		"jsdom": "^26.0.0",
		"prisma": "^7.4.1",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.2.2",
		"vitest": "^3.1.0"
	}
}
